[Desktop Entry]
Type=Application
Version=1.0
Name=PwrDisk
GenericName=Disk space treemap
Comment=Find what is using a volume, mark what should go, remove it
Exec=@BINDIR@/pwrdisk %f
Icon=pwrdisk
Terminal=false
Categories=System;Filesystem;
Keywords=disk;space;usage;du;treemap;cleanup;
StartupNotify=true
StartupWMClass=pwrdisk
# Registered for directories, so a file manager can offer "Open with PwrDisk".
# This adds a handler; it does not become the default.
MimeType=inode/directory;
Actions=disk;
X-AppVersion=@VERSION@

[Desktop Action disk]
Name=Scan the whole disk
Exec=@BINDIR@/pwrdisk --disk
